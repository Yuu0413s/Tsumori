{
  "name": "tsumori",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "build": "bun run --filter '*' build",
    "dev:web": "bun run --filter @tsumori/web dev",
    "dev:api": "bun run --filter @tsumori/api dev",
    "db:generate": "bun run --filter @tsumori/db generate",
    "db:migrate": "bun run --filter @tsumori/db migrate",
    "db:studio": "bun run --filter @tsumori/db studio",
    "db:migrate-legacy-auth": "bun run --filter @tsumori/db migrate-legacy-auth"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/bun": "^1.3.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0"
  }
}
