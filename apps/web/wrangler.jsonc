{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tsumori-web",
  "compatibility_date": "2026-07-27",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    // SPA なので、存在しないパスは index.html を返す
    "not_found_handling": "single-page-application",
  },
}
