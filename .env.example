# ===== 共通 =====
# Neon の接続文字列（pooler が付いていない direct 接続を推奨）
DATABASE_URL="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ===== apps/api =====
# better-auth のセッション署名用シークレット
# 生成: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:8787"

# Google OAuth（既存ユーザーの引き継ぎに必要）
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ===== Web Push（Phase 4 以降）=====
# 生成: bunx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:your-email@example.com"

# ===== apps/web =====
# Vite は VITE_ 接頭辞の変数のみクライアントに露出する
VITE_API_BASE_URL="http://localhost:8787"
